#autoload
#
# _dcsh_dispatch SUBCOMMAND [ARGS...]
#
# Route to the matching _dcsh::<sub> function. Short forms (sh, x, b) map to
# their long names. Unknown or missing subcommands print help and exit 1.

emulate -L zsh

if (( $# == 0 )); then
  _dcsh::help
  return 1
fi

local sub="$1"; shift

case "$sub" in
  up)               _dcsh::up "$@" ;;
  shell|sh)         _dcsh::shell "$@" ;;
  exec|x)           _dcsh::exec "$@" ;;
  build|b)          _dcsh::build "$@" ;;
  down)             _dcsh::down "$@" ;;
  help|-h|--help)   _dcsh::help "$@" ;;
  version|-v|--version) _dcsh::version "$@" ;;
  *)
    print -ru2 -- "devcontainer-sh: unknown subcommand: $sub"
    print -ru2 -- "Run 'devcontainer-sh help' for usage."
    return 1
    ;;
esac
