#compdef devcontainer-sh

_devcontainer_sh() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '1: :->subcmd' \
    '*::arg:->args'

  case "$state" in
    subcmd)
      local -a subs=(
        'up:Create and start the dev container'
        'shell:Open an interactive shell in the container'
        'sh:Alias for shell'
        'exec:Run a one-off command in the container'
        'x:Alias for exec'
        'build:Build the dev container image'
        'b:Alias for build'
        'down:Stop and remove the dev container'
        'help:Show usage'
        'version:Show plugin and devcontainer CLI versions'
      )
      _describe -t subcommands 'subcommand' subs
      ;;
    args)
      case "$line[1]" in
        up)
          _arguments \
            '-r[--remove-existing-container]' \
            '-n[--build-no-cache]' \
            '-R[remove existing + build no-cache]' \
            '-s[--skip-post-create]' \
            '--workspace-folder=[Workspace folder path]:dir:_directories' \
            '--config=[devcontainer.json path]:file:_files' \
            '--remove-existing-container[Remove the container if it already exists]' \
            '--build-no-cache[Build the image without cache]' \
            '--skip-post-create[Do not run post-create commands]' \
            '--skip-post-attach[Do not run postAttachCommand]' \
            '--skip-non-blocking-commands[Stop after waitFor]' \
            '--id-label=[Container id label name=value]:label' \
            '--mount=[Additional mount type=...,source=...,target=...]:mount' \
            '--remote-env=[Remote env name=value]:env' \
            '--cache-from=[Layer cache source]:image' \
            '--cache-to=[Layer cache destination]:image' \
            '--additional-features=[Additional features JSON]:json' \
            '--secrets-file=[Path to secrets JSON]:file:_files' \
            '--dotfiles-repository=[Dotfiles git repo URL]:url' \
            '--log-level=[Log level]:level:(info debug trace)' \
            '--log-format=[Log format]:format:(text json)'
          ;;
        shell|sh)
          _arguments \
            '--workspace-folder=[Workspace folder path]:dir:_directories' \
            '1::shell:(zsh bash sh fish dash ash)'
          ;;
        exec|x)
          _arguments \
            '--workspace-folder=[Workspace folder path]:dir:_directories' \
            '--container-id=[Container id]:id' \
            '--id-label=[Container id label name=value]:label' \
            '--remote-env=[Remote env name=value]:env' \
            '*::command: _command_names -e'
          ;;
        build|b)
          _arguments \
            '-n[--no-cache]' \
            '-p[--platform]:platform' \
            '--workspace-folder=[Workspace folder path]:dir:_directories' \
            '--config=[devcontainer.json path]:file:_files' \
            '--no-cache[Build without cache]' \
            '--image-name=[Image name]:name' \
            '--platform=[Target platforms]:platform' \
            '--push[Push to registry]' \
            '--output=[buildx --output value]:output' \
            '--label=[Image label key=value]:label' \
            '--cache-from=[Layer cache source]:image' \
            '--cache-to=[Layer cache destination]:image' \
            '--log-level=[Log level]:level:(info debug trace)' \
            '--log-format=[Log format]:format:(text json)'
          ;;
        down)
          _arguments \
            '--workspace-folder=[Workspace folder path]:dir:_directories'
          ;;
      esac
      ;;
  esac
}

_devcontainer_sh "$@"
